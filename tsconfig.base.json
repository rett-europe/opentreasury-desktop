{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // skipLibCheck: true — scaffold deviation from ADR-002 §4. Required because
    // electron.d.ts references DOM types + conflicts with strict @types/node
    // (e.g. duplicate `noDeprecation` decl). See ADR-002 Addendum (2026-04-19).
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "dist", "out", ".vite", "coverage", "playwright-report"]
}
