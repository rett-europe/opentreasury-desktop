# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Copilot CLI: per-session state (plans, checkpoints, drafts) — never committed
.copilot/session-state/

# Dependencies
node_modules/

# Build output
dist/
out/
.vite/

# Test + coverage
coverage/
playwright-report/
test-results/

# Editor / OS
.DS_Store
Thumbs.db

# Local env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Local user data — event logs / backups must NEVER be committed.
# The app stores these under %APPDATA%/opentreasury-desktop/ by default,
# but guard against accidental copies landing inside the working tree.
*.ndjson
*.ndjson.bak
events.jsonl
events.jsonl.bak
/dev-events/
/my-data/

# Transient test artifacts (event-log-smoke fixture)
.test-legacy-fixture-*/
.test-legacy-*/
.test-enveloped-*/
.test-seed-*/
