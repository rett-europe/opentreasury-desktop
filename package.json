{
  "name": "opentreasury-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-infrastructure treasury app for small NGOs. OneDrive is the database.",
  "author": "OpenTreasury contributors",
  "license": "See LICENSE",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite",
    "dev:empty": "cross-env OT_SEED=none OT_DATA_DIR=my-data vite",
    "dev:reset": "cross-env OT_DATA_DIR=my-data node scripts/reset-dogfood-data.mjs",
    "build": "npm run typecheck && vite build",
    "build:main": "tsc -b app/src/main",
    "build:preload": "tsc -b app/src/preload",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "playwright test",
    "perf:seed": "node scripts/perf-seed.mjs",
    "perf:measure": "vite-node scripts/perf-measure.ts",
    "package": "electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@napi-rs/keyring": "^1.1.0",
    "@tanstack/react-virtual": "^3.13.24",
    "exceljs": "^4.4.0",
    "i18next": "^23.11.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "lucide-react": "^1.8.0",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.0",
    "sodium-native": "^4.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.11.3",
    "cross-env": "^7.0.3",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fast-check": "^4.7.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
