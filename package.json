{
  "name": "opentreasury-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-infrastructure treasury app for small NGOs. OneDrive is the database.",
  "author": "OpenTreasury contributors",
  "license": "See LICENSE",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "echo 'TODO: wire vite + electron together once scaffold installs (see ADR-002 §11)' && exit 1",
    "build": "npm run typecheck && vite build",
    "build:main": "tsc -b app/src/main",
    "build:preload": "tsc -b app/src/preload",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "playwright test",
    "package": "electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "//": "Minimal: only what the shell needs to boot. Full dep list lands with first real feature PR.",
    "electron": "^31.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "i18next": "^23.11.0",
    "react-i18next": "^14.1.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "zod": "^3.23.0",
    "sodium-native": "^4.1.0",
    "@napi-rs/keyring": "^1.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.3.0",
    "vite": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vitest": "^1.6.0",
    "@testing-library/react": "^16.0.0",
    "@playwright/test": "^1.44.0",
    "electron-builder": "^24.13.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
